{
  "version": 2,
  "buildCommand": "npm run build --workspace=@pct/web",
  "outputDirectory": "packages/web/dist",
  "installCommand": "npm install --include=dev && npm install --prefix packages/web --include=dev",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@3",
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "packages/**,tsconfig.base.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
