# Copy this file to credentials/.env and fill in real values.
# credentials/.env is gitignored AND gcloudignored — never commit real secrets.

# Odoo - Purity
ODOO_PURITY_URL=
ODOO_PURITY_DB=
ODOO_PURITY_USERNAME=
ODOO_PURITY_API_KEY=

# Odoo - Babylon
ODOO_BABYLON_URL=
ODOO_BABYLON_DB=
ODOO_BABYLON_USERNAME=
ODOO_BABYLON_API_KEY=

# Firestore / BigQuery GCP - Control Tower
FIREBASE_PROJECT_ID=purity-control-tower-demo
# Path to the service-account JSON, relative to repo root:
GOOGLE_APPLICATION_CREDENTIALS=./credentials/purity-control-tower-demo-584cf0e5966f.json

# Shopify
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10

# API server (optional — dev defaults are fine)
# PORT=8080
# Comma-separated CORS origins for production (unset = allow all)
# CORS_ORIGIN=https://your-app.vercel.app
# When set, /api/* requires Authorization: Bearer <key> or x-api-key (except /api/health)
# API_KEY=

# ── Railway deployment (API) ───────────────────────────────────────
# Instead of GOOGLE_APPLICATION_CREDENTIALS (file path), paste the full
# service-account JSON content as a single string in Railway env vars:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"purity-control-tower-demo",...}

# ── Vercel deployment (frontend) ──────────────────────────────────
# Set this on Vercel so the built JS knows where the Railway API lives:
# VITE_API_BASE_URL=https://your-api.railway.app
