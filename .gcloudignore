# Files NOT uploaded to Cloud Build / Cloud Run / App Engine deploys.
# NOTE: presence of this file overrides the default of importing .gitignore,
# so secrets are listed explicitly here too.

# ── Secrets / credentials (NEVER deploy) ───────────────────────────
credentials/
*.env
.env
.env.*
!.env.example
*-service-account*.json
**/*serviceaccount*.json
purity-control-tower-*.json
*.pem
*.key

# ── Source control / dev tooling ───────────────────────────────────
.git/
.gitignore
.github/

# ── Node build artefacts / deps (rebuilt in the image) ─────────────
node_modules/
dist/
build/
coverage/
.vite/
.turbo/
*.tsbuildinfo
*.log

# ── Docs, fixtures, local discovery output ─────────────────────────
docs/
scripts/discover/out/
**/*.test.ts
**/__tests__/

# ── Editor / OS ────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
